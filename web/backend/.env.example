# Databricks SQL Warehouse Connection
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapi_your_databricks_personal_access_token_here

# Lakehouse Target
DATABRICKS_CATALOG=edgeshield_lakehouse
DATABRICKS_SCHEMA=gold

# Application Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CACHE_TTL_SECONDS=180
QUERY_TIMEOUT_SECONDS=45
