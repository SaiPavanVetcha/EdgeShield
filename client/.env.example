SERVER_IP=your_server_ip_here
SERVER_PORT=5000
SERVER_ENDPOINT=/metrics
DEVICE_ID=optional_device_id_override
SAMPLING_INTERVAL_SECONDS=10

# Optional room/location tag (e.g. Lab-A, Server-Room; default is "")
ROOM=

# Spool & Batching Settings
FLUSH_INTERVAL_SECONDS=60
FLUSH_MAX_RECORDS=20
SPOOL_MAX_RECORDS=5000
# SPOOL_DIR=./spool  # Optional override (default: client/spool)

# Logging Settings (optional)
LOG_DIR=./logs
LOG_FILE=./logs/client.log
